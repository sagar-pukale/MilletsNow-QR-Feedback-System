{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/{dist/**,node_modules/.prisma/client/**,node_modules/@prisma/client/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/auth",
      "destination": "/api/index.ts"
    },
    {
      "source": "/health",
      "destination": "/api/index.ts"
    },
    {
      "source": "/products/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/qrcodes/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/scan/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/feedback/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|auth/|auth$|health$|products/|qrcodes/|scan/|feedback/).*)",
      "destination": "/index.html"
    }
  ]
}
