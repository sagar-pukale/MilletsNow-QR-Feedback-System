generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique
  fullName     String     @map("full_name")
  role         UserRole   @default(operator)
  status       UserStatus @default(invited)
  passwordHash String?    @map("password_hash")
  avatarUrl    String?    @map("avatar_url")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  @@map("users")
}

enum UserRole {
  owner
  admin
  manager
  analyst
  operator
  @@map("user_role")
}

enum UserStatus {
  invited
  active
  suspended
  deactivated
  @@map("user_status")
}

enum FeedbackStatus {
  new
  in_review
  resolved
  archived
  @@map("feedback_status")
}

enum FeedbackPriority {
  low
  medium
  high
  urgent
  @@map("feedback_priority")
}

enum QRCodeStatus {
  active
  paused
  revoked
  @@map("qr_code_status")
}

model Category {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  name        String
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  @@map("categories")
}

model Product {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String?         @map("category_id") @db.Uuid
  createdBy    String?         @map("created_by") @db.Uuid
  name         String
  slug         String          @unique
  sku          String          @unique
  description  String?
  mrp          Decimal?        @db.Decimal(12, 2)
  sellingPrice Decimal?        @map("selling_price") @db.Decimal(12, 2)
  weight       Decimal?        @db.Decimal(10, 3)
  unit         String?
  brand        String?
  imageUrl     String?         @map("image_url")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at")
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches      ProductBatch[]
  qrCodes      QRCode[]
  feedbacks    Feedback[]
  stickerTemplates QRStickerTemplate[]
  @@map("products")
}

model ProductBatch {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  createdBy         String?   @map("created_by") @db.Uuid
  batchNumber       String    @map("batch_number")
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date
  quantity          Int       @default(0)
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  qrCodes           QRCode[]
  feedbacks         Feedback[]
  @@unique([productId, batchNumber])
  @@map("product_batches")
}

model QRCode {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  batchId        String?       @map("batch_id") @db.Uuid
  createdBy      String?       @map("created_by") @db.Uuid
  code           String        @unique
  status         QRCodeStatus  @default(active)
  destinationUrl String?       @map("destination_url")
  printedAt      DateTime?     @map("printed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch          ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  feedbacks      Feedback[]
  scanLogs       QRScanLog[]
  stickerTemplates QRStickerTemplate[]
  @@map("qr_codes")
}

model QRStickerTemplate {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  productId        String   @map("product_id") @db.Uuid
  qrCodeId         String   @map("qr_code_id") @db.Uuid
  productName      String   @map("product_name")
  productSku       String   @map("product_sku")
  qrToken          String   @map("qr_token")
  qrDestinationUrl String   @map("qr_destination_url")
  labelTemplate    String   @map("label_template")
  textMode         String   @map("text_mode")
  textSize         Int      @map("text_size")
  qrSize           Int      @map("qr_size")
  stickerConfig    Json     @map("sticker_config")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qrCode           QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  @@map("qr_sticker_templates")
}

model Customer {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalReference String?     @map("external_reference")
  fullName          String?     @map("full_name")
  email             String?
  phone             String?
  city              String?
  country           String?     @default("India")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at")
  feedbacks         Feedback[]
  scanLogs          QRScanLog[]
  @@map("customers")
}

model QRScanLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  qrCodeId   String    @map("qr_code_id") @db.Uuid
  customerId String?   @map("customer_id") @db.Uuid
  scannedAt  DateTime  @default(now()) @map("scanned_at")
  ipAddress  String?   @map("ip_address") @db.Inet
  userAgent  String?   @map("user_agent")
  deviceType String?   @map("device_type")
  city       String?
  country    String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  qrCode     QRCode    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  @@map("qr_scan_logs")
}

model Feedback {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String?          @map("customer_id") @db.Uuid
  productId      String?          @map("product_id") @db.Uuid
  batchId        String?          @map("batch_id") @db.Uuid
  qrCodeId       String?          @map("qr_code_id") @db.Uuid
  assignedTo     String?          @map("assigned_to") @db.Uuid
  source         String           @default("product_qr")
  email          String?
  rating         Int?
  message        String?
  imageUrl       String?          @map("image_url")
  quality        String?          @map("quality")
  category       String?          @map("category")
  latitude       Float?           @db.DoublePrecision
  longitude      Float?           @db.DoublePrecision
  locationAccuracy Float?         @map("location_accuracy") @db.DoublePrecision
  locationAddress String?         @map("location_address")
  userAgent      String?          @map("user_agent")
  deviceType     String?          @map("device_type")
  operatingSystem String?         @map("operating_system")
  browser        String?
  status         FeedbackStatus   @default(new)
  trackingPriority FeedbackPriority @default(medium) @map("tracking_priority")
  statusChangedAt DateTime        @default(now()) @map("status_changed_at")
  lastActionAt   DateTime         @default(now()) @map("last_action_at")
  resolvedAt     DateTime?        @map("resolved_at")
  submittedAt    DateTime         @default(now()) @map("submitted_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at")
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product        Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  batch          ProductBatch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  qrCode         QRCode?          @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  question       Question?
  compliment     Compliment?
  complaint      Complaint?
  @@map("feedback")
}

model Question {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId String    @unique @map("feedback_id") @db.Uuid
  question   String
  answer     String?
  answeredBy String?   @map("answered_by") @db.Uuid
  answeredAt DateTime? @map("answered_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  feedback   Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  @@map("questions")
}

model Compliment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId String   @unique @map("feedback_id") @db.Uuid
  message    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  @@map("compliments")
}

model Complaint {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId      String    @unique @map("feedback_id") @db.Uuid
  severity        Int       @default(1)
  resolutionNotes String?   @map("resolution_notes")
  resolvedBy      String?   @map("resolved_by") @db.Uuid
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  feedback        Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  @@map("complaints")
}
