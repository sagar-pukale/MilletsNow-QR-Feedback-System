generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique
  fullName     String     @map("full_name")
  role         UserRole   @default(operator)
  status       UserStatus @default(invited)
  passwordHash String?    @map("password_hash")
  avatarUrl    String?    @map("avatar_url")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at")
  @@map("users")
}

enum UserRole {
  owner
  admin
  manager
  analyst
  operator
  @@map("user_role")
}

enum UserStatus {
  invited
  active
  suspended
  deactivated
  @@map("user_status")
}

enum FeedbackStatus {
  new
  in_review
  resolved
  archived
  @@map("feedback_status")
}

enum QRCodeStatus {
  active
  paused
  revoked
  @@map("qr_code_status")
}

model Category {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  name        String
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  @@map("categories")
}

model Product {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId   String?         @map("category_id") @db.Uuid
  createdBy    String?         @map("created_by") @db.Uuid
  name         String
  slug         String          @unique
  sku          String          @unique
  description  String?
  mrp          Decimal?        @db.Decimal(12, 2)
  sellingPrice Decimal?        @map("selling_price") @db.Decimal(12, 2)
  weight       Decimal?        @db.Decimal(10, 3)
  unit         String?
  brand        String?
  imageUrl     String?         @map("image_url")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at")
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches      ProductBatch[]
  qrCodes      QRCode[]
  feedbacks    Feedback[]
  @@map("products")
}

model ProductBatch {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  batchNumber       String    @map("batch_number")
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date
  quantity          Int       @default(0)
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  qrCodes           QRCode[]
  feedbacks         Feedback[]
  @@unique([productId, batchNumber])
  @@map("product_batches")
}

model QRCode {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  batchId        String?      @map("batch_id") @db.Uuid
  code           String       @unique
  status         QRCodeStatus @default(active)
  destinationUrl String?      @map("destination_url")
  printedAt      DateTime?    @map("printed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch          ProductBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  feedbacks      Feedback[]
  @@map("qr_codes")
}

model Feedback {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String?        @map("product_id") @db.Uuid
  batchId     String?        @map("batch_id") @db.Uuid
  qrCodeId    String?        @map("qr_code_id") @db.Uuid
  rating      Int?
  message     String?
  status      FeedbackStatus @default(new)
  submittedAt DateTime       @default(now()) @map("submitted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  batch       ProductBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  qrCode      QRCode?        @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  question    Question?
  compliment  Compliment?
  complaint   Complaint?
  @@map("feedback")
}

model Question {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId String   @unique @map("feedback_id") @db.Uuid
  question   String
  answer     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  @@map("questions")
}

model Compliment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId String   @unique @map("feedback_id") @db.Uuid
  message    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  @@map("compliments")
}

model Complaint {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId      String   @unique @map("feedback_id") @db.Uuid
  severity        Int      @default(1)
  resolutionNotes String?  @map("resolution_notes")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  feedback        Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  @@map("complaints")
}
