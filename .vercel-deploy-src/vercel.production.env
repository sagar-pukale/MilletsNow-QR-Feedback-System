# Production secrets must be configured in Vercel and never committed here.
# Required secret types for production:
# - DATABASE_URL
# - JWT_SECRET
# - SUPABASE_URL
# - SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=
JWT_SECRET=
NODE_ENV=production
CORS_ORIGIN=https://millets-now-qr-feedback-system.vercel.app
PUBLIC_APP_URL=https://millets-now-qr-feedback-system.vercel.app
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=farmer-uploads
UPLOAD_DIR=uploads
